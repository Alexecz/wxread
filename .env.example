# 阅读次数配置 (默认40次/20分钟)
READ_NUM=40
# 随机阅读时长（分钟范围），设置后忽略 READ_NUM，例如 40-50
READ_MINUTES=

# 微信读书 curl bash 命令 (必需)
# 获取方式：
# 1. 打开微信读书网页版 https://weread.qq.com/
# 2. 打开浏览器开发者工具 (F12)
# 3. 切换到 Network 标签
# 4. 开始阅读任意书籍
# 5. 找到 'read' 请求，右键选择 "Copy as cURL (bash)"
# 6. 将完整的 curl 命令粘贴到下面
WXREAD_CURL_BASH=curl 'https://weread.qq.com/web/book/read' -H 'accept: application/json, text/plain, */*' -H 'cookie: YOUR_COOKIES_HERE' -H 'user-agent: Mozilla/5.0'

# 推送方式 (可选)
# 支持: pushplus, wxpusher, telegram, serverchan
PUSH_METHOD=

# PushPlus 推送配置 (可选)
# 官网: https://www.pushplus.plus/
PUSHPLUS_TOKEN=

# Telegram 推送配置 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WxPusher 推送配置 (可选)
# 官网: https://wxpusher.zjiecode.com/
# 方式一：极简推送 SPT
WXPUSHER_SPT=
# 方式二：标准推送（与米游社签到共用同一个 WxPusher 应用），填了则优先使用
WXPUSHER_APP_TOKEN=
# 接收人 UID，多个用英文逗号分隔
WXPUSHER_UIDS=

# 为 true 时只在 cookie 失效/运行失败时推送，成功不推送
PUSH_ONLY_FAILURE=true

# ServerChan 推送配置 (可选)
# 官网: https://sct.ftqq.com/
SERVERCHAN_SPT=

# 定时任务配置 (Cron 表达式格式)
# 默认每天凌晨1点执行: 0 1 * * *
# 其他示例:
#   每6小时: 0 */6 * * *
#   每天早上8:30: 30 8 * * *
#   每天中午12点: 0 12 * * *
CRON_SCHEDULE=0 1 * * *

# 触发后随机延迟的最大分钟数（精确到秒随机），0 或留空表示不延迟
# 例：CRON_SCHEDULE=0 6 * * * + RANDOM_DELAY_MINUTES=120 => 每天 06:00:00~08:00:00 随机开始
RANDOM_DELAY_MINUTES=
